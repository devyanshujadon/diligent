# Agent37 Cloud. Hosting API uses Authorization: Bearer.
# Instance chat uses the same key as X-Agent37-Key.
# Mint at https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# Optional. Reuse a running instance instead of creating one named "diligent".
# AGENT37_INSTANCE_IDS is a comma-separated pool so sub-agents can spread out.
AGENT37_INSTANCE_ID=
AGENT37_INSTANCE_IDS=

# OpenAI. Strong model is sent on Agent37 planner, critic, and writer turns.
# Cheap model extracts structured findings. Embeddings are 1536-d.
OPENAI_API_KEY=
OPENAI_STRONG_MODEL=gpt-5.4
OPENAI_EXTRACT_MODEL=gpt-5.4-nano
OPENAI_EMBED_MODEL=text-embedding-3-small

# Supabase. The server prefers the service role key. Anon is also accepted.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional sponsor. Traction research calls Monid discover, then run.
MONID_API_KEY=

# Optional. InstaCloud deploy token if you drive the API yourself.
# The Dockerfile is enough for `npx insta` / the InstaCloud agent.
INSTACLOUD_TOKEN=
